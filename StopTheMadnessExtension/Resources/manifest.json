{
  "manifest_version": 3,
  "name": "StopTheMadness Pro",
  "version": "1.0.0",
  "description": "Take back control of Safari on iOS: restore copy & paste, stop website tracking, block media autoplay, and eliminate annoying web banners.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "StopTheMadness Pro",
    "default_popup": "popup.html"
  }
}
